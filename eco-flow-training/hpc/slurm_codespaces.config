// Send every pipeline step to the practice Slurm "cluster" (started with
// `bash hpc/start_slurm.sh`) as its own job — just like on a real HPC.
//
//   nextflow run nf-core/demo -r 1.2.0 -profile test,docker \
//     -c hpc/slurm_codespaces.config --outdir demo_results

process {
    executor = 'slurm'
    queue    = 'codespace'    // the Slurm partition start_slurm.sh creates
}

executor {
    queueSize         = 4         // max jobs Nextflow keeps in the queue at once
    pollInterval      = '5 sec'   // check on jobs often — handy for a demo
    queueStatInterval = '5 sec'
}
